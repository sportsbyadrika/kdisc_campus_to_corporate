# Campus to Corporate - Apache front configuration
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block internal folders and dotfiles
    RewriteRule ^(app|database|node_modules)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(package(-lock)?\.json|router\.php)$ - [F,L]

    # Externally redirect "/page.php" -> "/page" (hide the .php extension)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Internally map "/page" -> "/page.php"
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

ErrorDocument 404 /404.php
ErrorDocument 403 /404.php
