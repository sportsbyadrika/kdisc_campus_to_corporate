# Campus to Corporate portal - environment configuration
# Copy this file to ".env" in the site root on the server:
#   /home/shooting/public_html/c2c.kdiscmis.org.in/.env
# and fill in the real values. The .env file is never committed to git and is
# never overwritten by the cPanel deployment. Web access to it is blocked by .htaccess.

# --- Database (cPanel > MySQL Databases) ------------------------------------
# cPanel prefixes database and user names with the account name, e.g. shooting_c2c
C2C_DB_HOST=localhost
C2C_DB_PORT=3306
C2C_DB_NAME=shooting_c2c
C2C_DB_USER=shooting_c2c
C2C_DB_PASS="change-me"

# --- Application -------------------------------------------------------------
# URL path the portal is served from. Empty when it is the domain root
# (https://c2c.kdiscmis.org.in), "/c2c" if it lives in a sub-folder.
C2C_BASE_PATH=

# Show PHP errors in the browser. Keep false in production.
C2C_DEBUG=false

C2C_TIMEZONE=Asia/Kolkata

# Maximum size of uploaded institution logo / photo, in MB
C2C_UPLOAD_MAX_MB=2

C2C_SESSION_NAME=c2c_session

# --- Public URL & email -------------------------------------------------------
# Full public address of the portal, used in the links inside emails.
C2C_APP_URL=https://campustocorporate.kdisc.in

# How emails are sent (PHPMailer):
#   mail = PHP mail() via the server's mail system (works on most cPanel servers)
#   sendmail = the server's sendmail binary directly
#   smtp = an SMTP mailbox (recommended for reliable delivery, e.g. a cPanel email account)
#   log  = do not send; only record in the mail_log table (testing)
C2C_MAIL_DRIVER=mail
# Sender address - use a mailbox on your own domain (create it in cPanel > Email Accounts)
C2C_MAIL_FROM=no-reply@campustocorporate.kdisc.in
C2C_MAIL_FROM_NAME="Campus to Corporate"

# Only for C2C_MAIL_DRIVER=smtp (cPanel > Email Accounts > Connect Devices shows these)
C2C_SMTP_HOST=mail.campustocorporate.kdisc.in
C2C_SMTP_PORT=465
C2C_SMTP_SECURE=ssl
C2C_SMTP_USER=no-reply@campustocorporate.kdisc.in
C2C_SMTP_PASS="change-me"
